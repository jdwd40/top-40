# Copy to .env and fill in real values. Never commit .env.

# Admin login (fixed server-side credentials). Admin login is disabled when unset.
TOP40_ADMIN_USER=admin
TOP40_ADMIN_PASSWORD=

# Secret for signing admin session cookies. When unset, a random per-boot
# secret is used and admin sessions are invalidated on restart.
TOP40_SESSION_SECRET=

# State file location (default: data/state.json).
TOP40_DATA_FILE=

# HTTP port (default: 3000).
TOP40_PORT=
